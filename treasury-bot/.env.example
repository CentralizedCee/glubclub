# Copy to .env and fill in as contracts produces real values.
# Nothing here should ever point at mainnet. Testnet only, per root CLAUDE.md.
#
# Naming matches contracts' deploy script (SAFE_ADDRESS, unprefixed) rather
# than frontend's NEXT_PUBLIC_ convention, since this script runs server-side
# / in CI and never ships to a browser.

# --- From /contracts (not deployed yet as of 2026-09-05, see docs/STATUS.md) ---
# TODO(contracts): fill in after testnet deploy
SAFE_ADDRESS=
TOKEN_CONTRACT_ADDRESS=
NFT_CONTRACT_ADDRESS=

# Comma-separated list of additional ERC-20 addresses to track as company
# reserves — this is where tokenized-equity (Stock Token) addresses go once
# the treasury actually holds any. Confirmed 2026-09-05: these are standard
# ERC-20s, readable via normal balanceOf(), so no special-casing needed here.
# TODO(contracts / human): fill in once the Safe actually holds any.
TRACKED_TOKEN_ADDRESSES=

# --- Chain config ---
# TODO(contracts): replace with the real Robinhood Chain testnet chainId/RPC
# once verified against current Robinhood Chain docs. Defaults to Arbitrum
# Sepolia (public, free testnet) as a stand-in, matching frontend/lib/chains.ts.
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
CHAIN_ID=421614

# How many past blocks to scan on the very first run (no prior state file
# yet). Keep small on a free public RPC — this is a testnet multisig, not a
# high-volume production wallet.
INITIAL_LOOKBACK_BLOCKS=5000
