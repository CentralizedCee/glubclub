# Copy to .env.local and fill in as the other sessions produce real values.
# Nothing here should ever point at mainnet. Testnet only, per root CLAUDE.md.

# --- From /contracts (not deployed yet as of 2026-09-05, see docs/STATUS.md) ---
# TODO(contracts): fill in after testnet deploy
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=
NEXT_PUBLIC_TOKEN_CONTRACT_ADDRESS=

# --- Chain config ---
# Robinhood Chain Testnet (chain ID 46630) -- verified against
# docs.robinhood.com/chain/connecting on 2026-09-05. Public RPC is used by
# default (rate-limited, no signup). Override with an Alchemy testnet key
# (https://robinhood-testnet.g.alchemy.com/v2/{API_KEY}) if you hit rate
# limits -- requires a free Alchemy account, so flagging rather than
# assuming it's in scope. See lib/chains.ts.
NEXT_PUBLIC_RPC_URL=

# --- From /treasury-bot (not built yet) ---
# TODO(treasury-bot): fill in once the read-only indexer exposes an endpoint
NEXT_PUBLIC_TREASURY_BOT_API_URL=

# --- Optional, free tier, NOT required ---
# Only needed if you want WalletConnect (mobile/QR wallets) in addition to
# browser-injected wallets (MetaMask etc.) and Coinbase Wallet, which need no
# signup at all. Get a free project ID at https://cloud.walletconnect.com if
# you want this — flagging per the zero-budget rule since it requires an
# account, even though the tier itself is free.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
